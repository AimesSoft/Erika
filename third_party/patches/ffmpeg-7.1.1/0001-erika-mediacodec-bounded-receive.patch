From 7f3f4f9d9c1a96a4e257d6a57ceee223a1a1c001 Mon Sep 17 00:00:00 2001
From: Erika Project <erika@example.invalid>
Date: Tue, 14 Jul 2026 00:00:00 +0800
Subject: [PATCH] avcodec/mediacodec: add command-aware nonblocking dequeue

Android's synchronous MediaCodec wrapper can remain parked in a dequeue
framework request after a codec transition even when the caller supplies a
positive timeout. That can keep an embedding playback worker inside
avcodec_receive_frame() indefinitely and prevent it from servicing seek,
track-switch, or shutdown commands.

Add an Erika-private decoder option that makes every MediaCodec input and
output dequeue use a zero timeout, including EOS submission and draining.
Yield EAGAIN to the embedding decode pump when no progress is possible, and
rate-limit the corresponding informational diagnostics. The option defaults
to disabled, preserving upstream behavior for every caller that does not
explicitly opt in.
---
 libavcodec/mediacodecdec.c        | 42 ++++++++++++++++++++++++++++++++-----
 libavcodec/mediacodecdec_common.c | 11 ++++++----
 libavcodec/mediacodecdec_common.h |  1 +
 3 files changed, 45 insertions(+), 9 deletions(-)

diff --git a/libavcodec/mediacodecdec.c b/libavcodec/mediacodecdec.c
index cc55b30..31aece3 100644
--- a/libavcodec/mediacodecdec.c
+++ b/libavcodec/mediacodecdec.c
@@ -55,10 +55,13 @@ typedef struct MediaCodecH264DecContext {
 
     int delay_flush;
     int amlogic_mpeg2_api23_workaround;
 
     int use_ndk_codec;
+    int erika_nonblocking;
+    int erika_nonblocking_yield_logged;
+    int erika_nonblocking_drain_yield_logged;
 } MediaCodecH264DecContext;
 
 static av_cold int mediacodec_decode_close(AVCodecContext *avctx)
 {
     MediaCodecH264DecContext *s = avctx->priv_data;
@@ -449,10 +452,11 @@ static av_cold int mediacodec_decode_init(AVCodecContext *avctx)
         goto done;
     }
 
     s->ctx->delay_flush = s->delay_flush;
     s->ctx->use_ndk_codec = s->use_ndk_codec;
+    s->ctx->erika_nonblocking = s->erika_nonblocking;
 
     if ((ret = ff_mediacodec_dec_init(avctx, s->ctx, codec_mime, format)) < 0) {
         s->ctx = NULL;
         goto done;
     }
@@ -503,27 +507,51 @@ static int mediacodec_receive_frame(AVCodecContext *avctx, AVFrame *frame)
 
     /* poll for new frame */
     ret = ff_mediacodec_dec_receive(avctx, s->ctx, frame, false);
     if (ret != AVERROR(EAGAIN))
         return ret;
+    if (s->erika_nonblocking && s->ctx->draining) {
+        if (!s->erika_nonblocking_drain_yield_logged) {
+            av_log(avctx, AV_LOG_INFO,
+                   "Erika nonblocking MediaCodec drain: yielding EAGAIN "
+                   "after zero-timeout output poll\n");
+            s->erika_nonblocking_drain_yield_logged = 1;
+        }
+        return AVERROR(EAGAIN);
+    }
 
     /* feed decoder */
     while (1) {
         if (s->ctx->current_input_buffer < 0 && !s->ctx->draining) {
             /* poll for input space */
             index = ff_AMediaCodec_dequeueInputBuffer(s->ctx->codec, 0);
             if (index < 0) {
                 /* no space, block for an output frame to appear */
-                ret = ff_mediacodec_dec_receive(avctx, s->ctx, frame, true);
+                ret = ff_mediacodec_dec_receive(avctx, s->ctx, frame, !s->erika_nonblocking);
                 /* Try again if both input port and output port return EAGAIN.
                  * If no data is consumed and no frame in output, it can make
                  * both avcodec_send_packet() and avcodec_receive_frame()
                  * return EAGAIN, which violate the design.
                  */
                 if (ff_AMediaCodec_infoTryAgainLater(s->ctx->codec, index) &&
-                    ret == AVERROR(EAGAIN))
+                    ret == AVERROR(EAGAIN)) {
+                    /* Embedders with their own command-aware decode pump must
+                     * regain control when a codec stalls. The zero-timeout
+                     * output poll above cannot intentionally park the worker;
+                     * leave upstream's internal retry behavior as the default.
+                     */
+                    if (s->erika_nonblocking) {
+                        if (!s->erika_nonblocking_yield_logged) {
+                            av_log(avctx, AV_LOG_INFO,
+                                   "Erika nonblocking MediaCodec receive: yielding "
+                                   "EAGAIN after zero-timeout input/output starvation\n");
+                            s->erika_nonblocking_yield_logged = 1;
+                        }
+                        return AVERROR(EAGAIN);
+                    }
                     continue;
+                }
                 return ret;
             }
             s->ctx->current_input_buffer = index;
         }
 
@@ -554,16 +582,16 @@ static int mediacodec_receive_frame(AVCodecContext *avctx, AVFrame *frame)
 
         /* fetch new packet or eof */
         ret = ff_decode_get_packet(avctx, &s->buffered_pkt);
         if (ret == AVERROR_EOF) {
             AVPacket null_pkt = { 0 };
-            ret = ff_mediacodec_dec_send(avctx, s->ctx, &null_pkt, true);
+            ret = ff_mediacodec_dec_send(avctx, s->ctx, &null_pkt, !s->erika_nonblocking);
             if (ret < 0)
                 return ret;
-            return ff_mediacodec_dec_receive(avctx, s->ctx, frame, true);
+            return ff_mediacodec_dec_receive(avctx, s->ctx, frame, !s->erika_nonblocking);
         } else if (ret == AVERROR(EAGAIN) && s->ctx->current_input_buffer < 0) {
-            return ff_mediacodec_dec_receive(avctx, s->ctx, frame, true);
+            return ff_mediacodec_dec_receive(avctx, s->ctx, frame, !s->erika_nonblocking);
         } else if (ret < 0) {
             return ret;
         }
     }
 
@@ -573,10 +601,12 @@ static int mediacodec_receive_frame(AVCodecContext *avctx, AVFrame *frame)
 static void mediacodec_decode_flush(AVCodecContext *avctx)
 {
     MediaCodecH264DecContext *s = avctx->priv_data;
 
     av_packet_unref(&s->buffered_pkt);
+    s->erika_nonblocking_yield_logged = 0;
+    s->erika_nonblocking_drain_yield_logged = 0;
 
     ff_mediacodec_dec_flush(avctx, s->ctx);
 }
 
 static const AVCodecHWConfigInternal *const mediacodec_hw_configs[] = {
@@ -597,10 +627,12 @@ static const AVCodecHWConfigInternal *const mediacodec_hw_configs[] = {
 static const AVOption ff_mediacodec_vdec_options[] = {
     { "delay_flush", "Delay flush until hw output buffers are returned to the decoder",
                      OFFSET(delay_flush), AV_OPT_TYPE_BOOL, {.i64 = 0}, 0, 1, VD },
     { "ndk_codec", "Use MediaCodec from NDK",
                    OFFSET(use_ndk_codec), AV_OPT_TYPE_BOOL, {.i64 = -1}, -1, 1, VD },
+    { "erika_nonblocking", "Use zero-timeout MediaCodec dequeues and yield EAGAIN on starvation",
+                           OFFSET(erika_nonblocking), AV_OPT_TYPE_BOOL, {.i64 = 0}, 0, 1, VD },
     { NULL }
 };
 
 #define DECLARE_MEDIACODEC_VCLASS(short_name)                   \
 static const AVClass ff_##short_name##_mediacodec_dec_class = { \
diff --git a/libavcodec/mediacodecdec_common.c b/libavcodec/mediacodecdec_common.c
index 3770b4f..234a4fe 100644
--- a/libavcodec/mediacodecdec_common.c
+++ b/libavcodec/mediacodecdec_common.c
@@ -887,11 +887,12 @@ int ff_mediacodec_dec_send(AVCodecContext *avctx, MediaCodecDecContext *s,
     int need_draining = 0;
     uint8_t *data;
     size_t size;
     FFAMediaCodec *codec = s->codec;
     int status;
-    int64_t input_dequeue_timeout_us = wait ? INPUT_DEQUEUE_TIMEOUT_US : 0;
+    int64_t input_dequeue_timeout_us = wait && !s->erika_nonblocking ?
+                                       INPUT_DEQUEUE_TIMEOUT_US : 0;
     int64_t pts;
 
     if (s->flushing) {
         av_log(avctx, AV_LOG_ERROR, "Decoder is flushing and cannot accept new buffer "
                                     "until all output buffers have been released\n");
@@ -988,11 +989,13 @@ int ff_mediacodec_dec_receive(AVCodecContext *avctx, MediaCodecDecContext *s,
 
     if (s->draining && s->eos) {
         return AVERROR_EOF;
     }
 
-    if (s->draining) {
+    if (s->erika_nonblocking) {
+        output_dequeue_timeout_us = 0;
+    } else if (s->draining) {
         /* If the codec is flushing or need to be flushed, block for a fair
          * amount of time to ensure we got a frame */
         output_dequeue_timeout_us = OUTPUT_DEQUEUE_BLOCK_TIMEOUT_US;
     } else if (s->output_buffer_count == 0 || !wait) {
         /* If the codec hasn't produced any frames, do not block so we
@@ -1068,15 +1071,15 @@ int ff_mediacodec_dec_receive(AVCodecContext *avctx, MediaCodecDecContext *s,
         }
 
     } else if (ff_AMediaCodec_infoOutputBuffersChanged(codec, index)) {
         ff_AMediaCodec_cleanOutputBuffers(codec);
     } else if (ff_AMediaCodec_infoTryAgainLater(codec, index)) {
-        if (s->draining) {
+        if (s->draining && !s->erika_nonblocking) {
             av_log(avctx, AV_LOG_ERROR, "Failed to dequeue output buffer within %" PRIi64 "ms "
                                         "while draining remaining frames, output will probably lack frames\n",
                                         output_dequeue_timeout_us / 1000);
-        } else {
+        } else if (!s->draining) {
             av_log(avctx, AV_LOG_TRACE, "No output buffer available, try again later\n");
         }
     } else {
         av_log(avctx, AV_LOG_ERROR, "Failed to dequeue output buffer (status=%zd)\n", index);
         return AVERROR_EXTERNAL;
diff --git a/libavcodec/mediacodecdec_common.h b/libavcodec/mediacodecdec_common.h
index 0ab2903..c307271 100644
--- a/libavcodec/mediacodecdec_common.h
+++ b/libavcodec/mediacodecdec_common.h
@@ -69,10 +69,11 @@ typedef struct MediaCodecDecContext {
 
     bool delay_flush;
     atomic_int serial;
 
     bool use_ndk_codec;
+    bool erika_nonblocking;
 } MediaCodecDecContext;
 
 int ff_mediacodec_dec_init(AVCodecContext *avctx,
                            MediaCodecDecContext *s,
                            const char *mime,
-- 
2.50.1

